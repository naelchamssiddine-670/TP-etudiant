<!DOCTYPE html>
<html lang="fr">
<head>
    <!-- Encodage des caracteres et affichage adapte au mobile -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Fichiers CSS de la navigation et de la page formation -->
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/formation.css">

    <!-- Titre de la page dans l'onglet -->
    <title>Formation</title>
</head>
<body>
    <!-- Inclusion de la barre de navigation -->
    <%- include('navbar') %>

    <!-- Titre principal de la page -->
    <h1>Liste des formations:</h1>

    <!-- Conteneur general des cartes de formation -->
    <div class="container">
        <!-- Premiere carte formation -->
        <div class="formation">
            <!-- Nom de la formation -->
            <h2>Formation en développement web:</h2>

            <!-- Lieu et dates -->
            <div><strong>Lieu:</strong> Mayotte — <small>2024-03-31 → 2026-04-30</small></div>

            <!-- Description courte -->
            <p>Apprenez les bases du développement web avec HTML, CSS et JavaScript.</p>

            <!-- Lien externe vers plus d'informations -->
            <a href="https://www.digitalschool.paris/guide/developpement-web/" target="_blank">
            <button> 📘 Plus d'infos sur la formation</button>
            </a>
        </div>

        <!-- Deuxieme carte formation -->
        <div class="formation">
            <h2>Formation en maintenance informatique:</h2>
            <div><strong>Lieu:</strong> Nantes — <small>2026-03-31 → 2027-04-30</small></div>
            <p>Découvrez les techniques de maintenance informatique, y compris la gestion des systèmes et la résolution de problèmes.</p>
            <a href="https://fr.indeed.com/conseils-carrieres/trouver-un-emploi/formations-maintenance-informatique" target="_blank">
            <button>🖥️ Plus d'infos sur la formation</button>
            </a>
        </div>

        <!-- Troisieme carte formation -->
        <div class="formation">
            <h2>Formation en cybersécurité:</h2>
            <div><strong>Lieu:</strong> Lyon — <small>2026-03-31 → 2026-04-30</small></div>
            <p>Apprenez les principes de la cybersécurité et comment protéger les systèmes informatiques contre les menaces.</p>
            <a href="https://www.cybermalveillance.gouv.fr/tous-nos-contenus/actualites/formation-cybersecurite" target="_blank">
            <button>🔐 Plus d'infos sur la formation</button>
            </a>
        </div>

        <!-- Quatrieme carte formation -->
        <div class="formation">
            <h2>Formation en comptabilité:</h2>
            <div><strong>Lieu:</strong> La Réunion — <small>2026-03-31 → 2026-04-30</small></div>
            <p>Apprenez les bases de la comptabilité et comment gérer les états financiers.</p>
            <a href="https://www.digitalschool.paris/guide/comptabilite/" target="_blank">
            <button>📚 Plus d'infos sur la formation</button>
            </a>
        </div>

        <!-- Cinquieme carte formation -->
        <div class="formation">
            <h2>Formation en marketing digital:</h2>
            <div><strong>Lieu:</strong> Paris — <small>2026-03-31 → 2026-04-30</small></div>
            <p>Découvrez les stratégies de marketing digital pour promouvoir votre entreprise en ligne.</p>
            <a href="https://www.digitalschool.paris/guide/marketing-digital/" target="_blank">
            <button>📈 Plus d'infos sur la formation</button>
            </a>
        </div>

        <!-- Sixieme carte formation -->
        <div class="formation">
            <h2>Formation en gestion de projet:</h2>
            <div><strong>Lieu:</strong> Marseille — <small>2026-03-31 → 2026-04-30</small></div>
            <p>Apprenez les compétences nécessaires pour gérer efficacement des projets et atteindre vos objectifs.</p>
            <a href="https://www.cadremploi.fr/editorial/conseils/conseils-carriere/detail/article/formation-gestion-de-projet.html" target="_blank">
            <button>📊 Plus d'infos sur la formation</button>
            </a>
            </a>
        </div>
    </div>
    
</body>
</html>
