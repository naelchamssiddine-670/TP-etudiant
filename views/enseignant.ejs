<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enseignant</title>
    <link rel="stylesheet" href="/css/enseignant.css">
    <script src="/js/modal.js"></script>
</head>
<body>
    <%- include('navbar') %>

    <h1>Espace Enseignant</h1>

    <div><!-- Contenu de la page enseignant -->
        <button id="myBtn">Ajouter Enseignant</button>
    </div>
    <!-- Modal d'ajout d'enseignant -->
     <div id="myModal" class="modal">
     <div class="modal-content"><!--Bouton de fermeture modal-->
        <span class="close">&times;</span><!-- Contenu du modal -->
        <p>Formulaire d'ajout d'enseignant</p><!--En tête du modal-->


        <div class="modal-body">
            <p>Veuillez remplir les informations suivantes :</p>

            <div class="container">
                <form action="/api/enseignant" method="post">
                    <div class="row">
                        <div class="col-25">
                            <label for="nom">Nom:</label>
                        </div>
                        <div class="col-75">
                            <input type="text" name="nom" id="nommembreEnseignant">
                        </div>
                    </div>
                    <!--ligne 2-->
                    <div class="row">
                        <div class="col-25">
                            <label for="prenom">Prénom:</label>
                        </div>
                        <div class="col-75">
                            <input type="text" name="prenom" id="prenommembreEnseignant">
                        </div>
                    </div>
                    <!--ligne 3-->
                    <div class="row">
                        <div class="col-25">
                            <label for="date_recrutement">Date de recrutement:</label>
                        </div>
                        <div class="col-75">
                            <input type="date" name="date_recrutement" id="date_recrutement">
                        </div>
                    </div>
                    <!--ligne 4-->
                    <div class="row">
                        <div class="col-25">
                            <label for="matiere_enseignee">Matière enseignée:</label>
                        </div>
                        <div class="col-75">
                            <input type="text" name="matiere_enseignee" id="matiere_enseignee">
                        </div>
                    </div>
                    <button id="btnEnregistrer">Enregistrer</button>
                </form>
            </div>
        </div>

     </div>
        <div class="modal-content">

        <!-- Pied de page de modal-->
        <div class="modal-footer">
            <h3>Merci de votre contribution !</h3>
        </div>
     </div>
</body>
</html>