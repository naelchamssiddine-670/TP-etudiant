<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enseignant</title>
    <link rel="stylesheet" href="/css/enseignant.css">
    <script src="/js/enseignant.js" defer></script>
</head>
<body>
    <%- include('navbar') %>

    <h1>Espace Enseignant</h1>

    <div class="container">
        <div class="header">
            <h2>Ajouter un enseignant</h2>
            <p id="textenseignant">Cliquez sur le bouton pour afficher le formulaire d'inscription.</p>
            <button type="button" id="open-teacher-modal">Ajouter un enseignant</button>
        </div>

        <div id="teacher-modal" class="modal">
            <div class="modal-content">
                <button type="button" class="close-button" id="close-teacher-modal">&times;</button>

                <div class="modal-body">
                    <div class="container">
                        <form action="/api/enseignant" method="post">
                            <div class="row">
                                <div class="col-25">
                                    <label for="nomEnseignant">Nom de l'enseignant:</label>
                                </div>
                                <div class="col-75">
                                    <input type="text" name="nom" id="nomEnseignant" required>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-25">
                                    <label for="prenomEnseignant">Prenom de l'enseignant:</label>
                                </div>
                                <div class="col-75">
                                    <input type="text" name="prenom" id="prenomEnseignant" required>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-25">
                                    <label for="date_recrutement">Date de recrutement:</label>
                                </div>
                                <div class="col-75">
                                    <input type="date" name="date_recrutement" id="date_recrutement" required>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-25">
                                    <label for="matiere_enseignee">Matiere enseignee:</label>
                                </div>
                                <div class="col-75">
                                    <input type="text" name="matiere_enseignee" id="matiere_enseignee" required>
                                </div>
                            </div>

                            <div>
                                <button id="myBtn" type="submit">Valider l'ajout</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
