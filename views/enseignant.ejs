<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enseignant</title>
    <link rel="stylesheet" href="/css/enseignant.css">
    <script src="/js/enseignant.js" defer></script>
</head>
<body>
    <%- include('navbar') %>

    <h1>Espace Enseignant</h1>
    <!-- Modal d'ajout d'enseignant -->
     <div id="myModal" class="modal">


        <div class="modal-header">
            <h2>Formulaire d'ajout d'enseignant:</h2><!--En tête du modal-->
        </div>

        <div class="modal-body"><!--Corps du modal-->
            <p id="textenseignant">Veuillez remplir les informations suivantes :</p><!-- Instructions pour remplir le formulaire-->

            <!-- Formulaire d'ajout d'enseignant -->
            <div class="container">
                <form action="/api/enseignant" method="post">
                    <div class="row">
                        <div class="col-25">
                            <label for="nomEnseignant">Nom de l'enseignant:</label>
                        </div>
                        <div class="col-75">
                            <input type="text" name="nom" id="nomEnseignant">
                        </div>
                    </div>
                    <!--ligne 2-->
                    <div class="row">
                        <div class="col-25">
                            <label for="prenomEnseignant">Prénom de l'enseignant:</label>
                        </div>
                        <div class="col-75">
                            <input type="text" name="prenom" id="prenomEnseignant">
                        </div>
                    </div>
                    <!--ligne 3-->
                    <div class="row">
                        <div class="col-25">
                            <label for="date_recrutement">Date de recrutement:</label>
                        </div>
                        <div class="col-75">
                            <input type="date" name="date_recrutement" id="date_recrutement">
                        </div>
                    </div>
                    <!--ligne 4-->
                    <div class="row">
                        <div class="col-25">
                            <label for="matiere_enseignee">Matière enseignée:</label>
                        </div>
                        <div class="col-75">
                            <input type="text" name="matiere_enseignee" id="matiere_enseignee">
                        </div>
                    </div>
                    <!-- Bouton de soumission -->
                    <div>
                    <button id="myBtn">Ajouter un enseignant</button>
                    </div>
                </form>
            </div>
        </div>

     </div>
        <div class="container">
        <div class="header">
        
        </div>

        <!-- Pied de page de modal-->
        <div class="modal-footer">
     </div>
</body>
</html>